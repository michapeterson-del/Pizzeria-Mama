# Kopiere diese Datei zu ".env" und trage eigene Werte ein.

# Pflicht: Passwort für den Admin-Bereich (/admin), mind. 10 Zeichen. Ohne startet der Server nicht.
ADMIN_PASSWORD=bitte-eigenes-passwort-eintragen

# Pflicht: zufälliger geheimer Text (mind. 32 Zeichen), z. B. `openssl rand -hex 32`.
SESSION_SECRET=bitte-zufaelligen-text-eintragen

# Port, auf dem der Server läuft (optional)
PORT=3000

# Ordner für die dauerhafte Speicherung der Bestellungen (orders.json).
# Bei Render: auf den Mount-Pfad der Persistent Disk setzen, z. B. /var/data
# Lokal: einfach weglassen, dann wird der data/-Ordner im Projekt genutzt.
# DATA_DIR=/var/data
